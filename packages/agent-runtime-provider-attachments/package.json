{
  "name": "@marshal/agent-runtime-provider-attachments",
  "version": "0.1.0",
  "description": "Attachment conversion provider for the Marshal agent runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@marshal/agent-runtime-core": "0.1.0",
    "@marshal/agent-runtime-provider-kit": "0.1.0",
    "@marshal/content-to-markdown": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.13.0" },
  "license": "MIT"
}
