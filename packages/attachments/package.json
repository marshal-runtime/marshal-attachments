{
  "name": "@marshal/attachments",
  "version": "0.1.0",
  "description": "Marshal attachment resolution, safe conversion, and Markdown extraction",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./content-to-markdown": {
      "types": "./dist/content-to-markdown/index.d.ts",
      "default": "./dist/content-to-markdown/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@marshal/agent-runtime-provider-attachments": "workspace:*",
    "@marshal/content-to-markdown": "workspace:*",
    "@marshal/runtime": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/turndown": "^5.0.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=24.14.0" },
  "license": "MIT"
}
